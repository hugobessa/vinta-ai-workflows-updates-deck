{
  "name": "vinta-slides",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vinta 2023 presentation template as a reusable React + Tailwind slide-deck library",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "export": "node scripts/export-deck.mjs",
    "export:pdf": "node scripts/export-deck.mjs --format pdf",
    "export:pptx": "node scripts/export-deck.mjs --format pptx",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
